generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum AccountType {
  INDIVIDUAL
  BUSINESS
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
  EXPIRED
}

enum PaymentProvider {
  STRIPE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  email           String           @unique @db.VarChar(255)
  fullName        String?          @db.VarChar(150)
  passwordHash    String           @db.VarChar(255)
  role            UserRole         @default(CUSTOMER)
  emailVerifiedAt                DateTime? @db.Timestamptz(3)
  emailVerificationTokenHash     String?   @unique @db.VarChar(64)
  emailVerificationExpiresAt     DateTime? @db.Timestamptz(3)
  isActive                       Boolean   @default(true)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  customerProfile CustomerProfile?
  sessions        Session[]
  cart            Cart?
  orders          Order[]
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String   @unique @db.VarChar(64)
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  lastUsedAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model CustomerProfile {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @unique @db.Uuid
  accountType AccountType
  fullName    String?     @db.VarChar(150)
  legalName   String?     @db.VarChar(200)
  tradeName   String?     @db.VarChar(200)
  taxId       String      @unique @db.VarChar(20)
  phone       String?     @db.VarChar(30)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses Address[]
}

model Address {
  id            String   @id @default(uuid()) @db.Uuid
  customerId    String   @db.Uuid
  label         String?  @db.VarChar(80)
  recipientName String   @db.VarChar(150)
  street        String   @db.VarChar(200)
  number        String   @db.VarChar(30)
  complement    String?  @db.VarChar(120)
  neighborhood  String?  @db.VarChar(120)
  city          String   @db.VarChar(120)
  state         String   @db.VarChar(120)
  postalCode    String   @db.VarChar(20)
  country       String   @db.VarChar(2)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(120)
  slug        String   @unique @db.VarChar(140)
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  products Product[]
}

model Product {
  id           String   @id @default(uuid()) @db.Uuid
  categoryId   String   @db.Uuid
  name         String   @db.VarChar(180)
  slug         String   @unique @db.VarChar(200)
  sku          String   @unique @db.VarChar(80)
  description  String   @db.Text
  priceInCents Int
  currency     String   @db.VarChar(3)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images     ProductImage[]
  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([isActive])
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  url       String   @db.Text
  altText   String?  @db.VarChar(200)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@index([productId])
}

model Inventory {
  id               String   @id @default(uuid()) @db.Uuid
  productId        String   @unique @db.Uuid
  quantity         Int      @default(0)
  reservedQuantity Int      @default(0)
  reorderPoint     Int      @default(0)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @db.Uuid
  productId String   @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  orderNumber String      @unique @db.VarChar(30)
  userId      String?     @db.Uuid
  status      OrderStatus @default(PENDING_PAYMENT)
  currency    String      @db.VarChar(3)

  subtotalInCents Int
  shippingInCents Int @default(0)
  totalInCents    Int

  customerAccountType AccountType
  customerName        String      @db.VarChar(200)
  customerEmail       String      @db.VarChar(255)
  customerTaxId       String      @db.VarChar(20)
  customerPhone       String?     @db.VarChar(30)

  shippingRecipientName String  @db.VarChar(150)
  shippingStreet        String  @db.VarChar(200)
  shippingNumber        String  @db.VarChar(30)
  shippingComplement    String? @db.VarChar(120)
  shippingNeighborhood  String? @db.VarChar(120)
  shippingCity          String  @db.VarChar(120)
  shippingState         String  @db.VarChar(120)
  shippingPostalCode    String  @db.VarChar(20)
  shippingCountry       String  @db.VarChar(2)

  reservationExpiresAt DateTime @db.Timestamptz(3)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  user     User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  payments Payment[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([reservationExpiresAt])
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @db.Uuid
  productId String? @db.Uuid

  productName String @db.VarChar(180)
  productSlug String @db.VarChar(200)
  productSku  String @db.VarChar(80)

  unitPriceInCents Int
  quantity         Int
  lineTotalInCents Int

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id       String          @id @default(uuid()) @db.Uuid
  orderId  String          @db.Uuid
  provider PaymentProvider @default(STRIPE)
  status   PaymentStatus   @default(PENDING)

  amountInCents Int
  currency      String @db.VarChar(3)

  providerPaymentIntentId String? @unique @db.VarChar(255)

  failureCode    String? @db.VarChar(120)
  failureMessage String? @db.VarChar(500)

  succeededAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([status])
}
