{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "api": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.api.vercel"
    }
  },
  "daemons": {
    "jobs": {
      "root": ".",
      "entrypoint": "Dockerfile.api.vercel",
      "command": [
        "node",
        "dist/worker.js"
      ],
      "instances": {
        "iad1": 0
      },
      "resources": {
        "requests": {
          "memory": "1Gi"
        }
      },
      "terminationGracePeriodSeconds": 120
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
