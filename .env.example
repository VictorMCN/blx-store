# PostgreSQL
POSTGRES_DB=blx_store
POSTGRES_USER=blx_store
POSTGRES_PASSWORD=replace_with_a_secure_local_password
POSTGRES_PORT=5432

DATABASE_URL=postgresql://blx_store:replace_with_a_secure_local_password@localhost:5432/blx_store

# Application URLs
APP_URL=http://localhost:3000
API_ORIGIN=http://localhost:3001

# NestJS
PORT=3001

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_with_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_stripe_webhook_secret

# Email
EMAIL_DELIVERY_ENABLED=false
RESEND_API_KEY=re_replace_with_resend_api_key
EMAIL_FROM="BLX Store <orders@example.com>"

# AI
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-6-luna
OPENAI_FALLBACK_MODEL=gpt-6.1-sol
